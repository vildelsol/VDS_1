{
  "name": "react-example",
  "private": true,
  "version": "1.13.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js sea-config.json",
    "lint": "tsc --noEmit",
    "test": "npm run build && node test/run.mjs",
    "test:run": "node test/run.mjs",
    "setup": "node scripts/setup.mjs",
    "build:exe-bundle": "esbuild server.ts --bundle --platform=node --format=cjs --external:vite --outfile=dist/server-bundle.cjs",
    "build:sea-config": "node scripts/build-sea-assets.mjs",
    "build:sea-blob": "node --experimental-sea-config sea-config.json",
    "build:exe-prep": "npm run build && npm run build:exe-bundle && npm run build:sea-config && npm run build:sea-blob"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
